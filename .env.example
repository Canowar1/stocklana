# Copy this file to .env and fill it in. .env is gitignored and must never be
# committed. Nothing in this repo reads a private key from an environment
# variable: keys are always referenced by file path.

# Which network the scripts act on: localnet | devnet | mainnet
CLUSTER=devnet

# RPC endpoint. Leave blank to use the public endpoint for CLUSTER.
# A private endpoint is strongly recommended: the public devnet RPC rate limits
# airdrops and getProgramAccounts, both of which the deploy path uses.
RPC_URL=

# The keypair that pays for and signs the deployment.
#
#   solana-keygen new -o keys/devnet-deployer.json
#
# then fund it at https://faucet.solana.com. A first deploy of this program
# needs roughly 3.5 SOL of rent, which is refundable if the program is closed.
# keys/ is gitignored. Never commit this file and never paste its contents.
DEPLOYER_KEYPAIR=keys/devnet-deployer.json

# The program keypair. Its public key is the on-chain program id. Generated by
# anchor init and backed up in keys/. Losing it changes the program id.
PROGRAM_KEYPAIR=keys/stocklana-program-keypair.json

# Protocol fee taken from an accepted premium, in basis points.
FEE_BPS=50

# Minimum seconds between writing a call and its expiry. Small on devnet so a
# demo can run end to end; an hour or more on mainnet.
MIN_DURATION_SECS=60

# Oracle staleness ceiling applied when registering a market, in seconds.
# Equity feeds go quiet for days outside market hours, so a devnet market that
# must settle on demand uses a wide window. Mainnet markets use 3600.
MAX_STALENESS_SECS=3600
