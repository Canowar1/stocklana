# Vercel project setting: Root Directory = web.
# Leave "Include source files outside of the Root Directory" on. The app
# imports config/markets.<cluster>.json from the repo root.
# Do not set the build command to `npm run build` from the repo root. That
# script compiles the Solana program and will fail on Vercel.
#
# Which deployment the interface reads. Markets come from
# config/markets.<cluster>.json in the repo root.
NEXT_PUBLIC_CLUSTER=devnet

# Leave blank to use the public endpoint for the cluster above. A private
# endpoint is worth having: the interface polls oracle accounts continuously.
NEXT_PUBLIC_RPC_URL=

NEXT_PUBLIC_PROGRAM_ID=EZRD9fkVxxQy97Ls35vDsnhQ1Tn8b6HagWeXV8GyqgNQ

# Leave unset on the public deployment. The faucet is not part of the product.
# If this is set, the server route can mint. It must never gain a NEXT_PUBLIC_
# prefix. Next.js would then ship the key to the browser.
FAUCET_AUTHORITY_SECRET=
